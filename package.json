{
	"name": "render",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": "24.21.0"
	},
	"scripts": {
		"start": "node src/host/main.ts serve",
		"test": "node --test --test-concurrency=8 test/*.test.ts",
		"test:integration": "node --test --test-concurrency=2 test/*.integration.ts",
		"test:performance": "node --test --test-concurrency=1 test/*.performance.ts",
		"test:full": "npm test && npm run test:integration && npm run test:performance",
		"test:extended": "npm run verify:sqlite-command-atomicity && npm run verify:history-command-load",
		"verify:gate": "npm run typecheck && npm run lint && npm run test:full",
		"verify:complete": "npm run verify:gate && npm run test:extended",
		"typecheck": "tsc --noEmit -p .",
		"lint": "biome check .",
		"verify:implementation-pass": "node --test --test-concurrency=1 test/implementation-pass.test.ts test/implementation-pass-schedules.test.ts test/implementation-lifecycle.test.ts test/implementation-successor.test.ts test/implementation-lifecycle-crash.integration.ts test/accepted-contracts.test.ts test/intake-retention.test.ts test/role-capability-refusal.test.ts test/implementation-capture.integration.ts test/implementation-engine.integration.ts",
		"verify:implementation-crash": "node --test test/implementation-lifecycle-crash.integration.ts",
		"verify:protocol-experiments": "node --test --test-concurrency=1 test/protocol-experiments.test.ts test/experiment-intake.test.ts test/experiment-design-candidates.test.ts test/experiment-isolation.integration.ts test/experiment-journey.integration.ts test/experiment-crash.integration.ts test/experiment-cancel.integration.ts",
		"verify:experiment-crash": "node --test test/experiment-crash.integration.ts",
		"verify:design-candidates": "node --test --test-concurrency=1 test/design-candidates.test.ts test/editable-checkpoints.test.ts test/context-continuation-independence.test.ts test/web-evidence-retention.test.ts",
		"verify:accepted-contracts": "node --test --test-concurrency=1 test/accepted-contracts.test.ts test/intake-retention.test.ts",
		"verify:checkpoint-settings": "node --test --test-concurrency=1 test/checkpoint-settings.test.ts test/checkpoint-authority.test.ts test/editable-checkpoints.test.ts test/policy-adoption.test.ts",
		"verify:editable-checkpoints": "node --test --test-concurrency=1 test/checkpoint-authority.test.ts test/editable-checkpoints.test.ts",
		"verify:ground-investigation": "node --test --test-concurrency=1 test/ground-investigation.test.ts test/investigation-crash.integration.ts",
		"verify:investigation-crash": "node --test test/investigation-crash.integration.ts",
		"verify:kernel-authority-schedules": "RENDER_V1_SCHEDULES=10000 node --test test/kernel-effect.test.ts test/kernel-authority-schedules.test.ts test/implementation-pass-schedules.test.ts test/watchdog-rework-schedules.test.ts test/canonical-integration-schedules.test.ts",
		"verify:sqlite-command-atomicity": "RENDER_V2_SCHEDULES=256 node --test test/sqlite-command-atomicity.test.ts test/sqlite-command-schedules.integration.ts",
		"verify:command-crash-recovery": "node --test test/command-crash-recovery.integration.ts",
		"verify:two-client-reattach": "node --test --test-concurrency=1 test/two-client-reattach.integration.ts test/stalled-observer.performance.ts test/history-cutoff-export.test.ts test/history-cursor-transfer.test.ts",
		"verify:persistence-startup": "node --test test/persistence-startup.integration.ts test/role-recovery-startup.integration.ts",
		"verify:local-command-load": "node --test test/local-command-load.performance.ts",
		"verify:scoped-web-research": "node --test test/scoped-web-research.test.ts test/web-evidence-retention.test.ts test/web-crash.integration.ts test/web-report-declaration.test.ts test/web-cancellation-outcome.test.ts",
		"verify:web-negative-journey": "node --test --test-name-pattern='selected negative evidence' test/web-evidence-retention.test.ts",
		"verify:durable-tool-replay": "node --test test/durable-tool-replay.integration.ts",
		"verify:workflow-task-survival": "node --test test/workflow-task-survival.test.ts",
		"verify:role-capability-refusal": "node --test test/role-capability-refusal.test.ts",
		"verify:cancellation-capacity": "node --test test/cancellation-capacity.test.ts test/role-recovery-startup.integration.ts test/role-waiting.integration.ts test/role-wait-restart.integration.ts",
		"verify:history-cutoff-export": "node --test test/history-cutoff-export.test.ts test/history-missing-data.integration.ts test/history-message.test.ts test/history-completeness.integration.ts test/history-cursor-transfer.test.ts test/role-history.test.ts",
		"verify:history-command-load": "node --test test/history-command-load.ts",
		"verify:context-continuation-independence": "node --test test/context-continuation-independence.test.ts test/workflow-task-survival.test.ts test/role-wait-restart.integration.ts test/child-replacement.test.ts",
		"verify:native-compaction-history": "node --test test/native-compaction-history.test.ts",
		"verify:policy-adoption": "node --test test/policy-adoption.test.ts test/child-replacement.test.ts",
		"verify:task-version-recovery": "node --test test/task-version-recovery.test.ts test/role-recovery-startup.integration.ts",
		"verify:independent-export-reader": "node --test test/independent-export-reader.test.ts",
		"verify:linux-profile-owned-check": "node --test test/linux-profile-owned-check.integration.ts test/owned-check-history.integration.ts test/owned-source-recovery.integration.ts",
		"verify:literal-source-roundtrip": "node --test test/literal-source-roundtrip.integration.ts test/literal-source-names.test.ts test/literal-source-names.integration.ts test/owned-source-controls.integration.ts",
		"verify:whole-container-quiescence": "node --test test/whole-container-quiescence.integration.ts test/owned-source-recovery.integration.ts test/owned-check-cancellation.integration.ts",
		"verify:source-root-crash": "node --test test/source-root-crash.integration.ts test/owned-check-crash.integration.ts",
		"verify:local-verification-prompt": "node --test --test-concurrency=1 test/local-verification-prompt.test.ts test/intake-retention.test.ts test/verification-catalog.integration.ts",
		"verify:target-preparation": "node --test --test-concurrency=1 test/target-preparation.test.ts test/target-preparation-record.test.ts test/implementation-successor.test.ts test/implementation-engine.integration.ts test/target-preparation-crash.integration.ts",
		"verify:preparation-crash": "node --test test/target-preparation-crash.integration.ts",
		"verify:watchdog-rework": "node --test --test-concurrency=1 test/watchdog-rework.test.ts test/watchdog-rework-schedules.test.ts test/implementation-successor.test.ts test/watchdog-rework.integration.ts test/watchdog-crash.integration.ts",
		"verify:watchdog-crash": "node --test test/watchdog-crash.integration.ts",
		"verify:existing-seam-change": "node --test --test-concurrency=1 test/existing-seam-change.test.ts test/accepted-contracts.test.ts test/intake-retention.test.ts test/canonical-integration.test.ts",
		"verify:record-baseline": "node --test --test-concurrency=1 test/record-baseline.test.ts test/accepted-contracts.test.ts test/canonical-integration.test.ts",
		"verify:canonical-integration": "node --test --test-concurrency=1 test/canonical-integration.test.ts test/canonical-integration-effects.test.ts test/canonical-integration-schedules.test.ts test/canonical-integration.integration.ts test/canonical-integration-crash.integration.ts test/watchdog-rework.integration.ts",
		"verify:integration-crash": "node --test test/canonical-integration-crash.integration.ts",
		"verify:github-publication": "node --test --test-concurrency=1 test/github-publication.test.ts test/github-publication-forge.test.ts test/github-publication.integration.ts",
		"verify:human-merge-observation": "node --test --test-concurrency=1 test/human-merge-observation.test.ts test/human-merge-observation-forge.test.ts test/github-publication.test.ts test/github-publication-forge.test.ts test/accepted-contracts.test.ts test/github-publication.integration.ts",
		"verify:automatic-readiness": "node --test --test-concurrency=1 test/automatic-readiness.test.ts test/automatic-readiness-forge.test.ts test/github-publication.integration.ts",
		"verify:v9-workload": "node --test test/v9-workload.performance.ts",
		"verify:performance-journey": "node --test --test-concurrency=1 test/performance-journey.test.ts test/accepted-contracts.test.ts test/watchdog-rework.test.ts",
		"verify:verification-catalog": "node --test --test-concurrency=1 test/verification-catalog.test.ts test/verification-catalog.integration.ts",
		"verify:verification-maintenance": "node --test --test-concurrency=1 test/verification-maintenance.integration.ts test/verification-catalog.test.ts test/implementation-successor.test.ts",
		"verify:verification-authoring": "node --test --test-concurrency=1 test/verification-authoring.integration.ts test/verification-catalog.test.ts test/verification-catalog.integration.ts",
		"verify:bug-journey": "node --test --test-concurrency=1 test/bug-journey.test.ts test/accepted-contracts.test.ts test/bug-journey.integration.ts"
	},
	"dependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"effect": "4.1.2",
		"webfox": "4.8.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@types/node": "24.19.2",
		"typescript": "7.0.2"
	}
}

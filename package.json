{
	"name": "render",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": "24.21.0"
	},
	"scripts": {
		"start": "node src/host/main.ts serve",
		"test": "node --test --test-concurrency=4 test/*.test.ts",
		"test:integration": "node --test --test-concurrency=1 test/*.integration.ts",
		"test:performance": "node --test --test-concurrency=1 test/*.performance.ts",
		"test:full": "node --test --test-concurrency=1 test/*.test.ts test/*.integration.ts test/*.performance.ts",
		"test:extended": "npm run test:extended:host && npm run test:extended:containers",
		"test:extended:host": "npm run verify:sqlite-command-atomicity && npm run verify:history-command-load && RENDER_V3_REPETITIONS=100 npm run verify:command-crash-recovery && RENDER_V3_REPETITIONS=100 npm run verify:durable-tool-replay && RENDER_V3_REPETITIONS=100 npm run verify:repair-crash && RENDER_V3_REPETITIONS=100 npm run verify:offhost-exposure-cutoff && RENDER_V3_REPETITIONS=100 npm run verify:scoped-web-research",
		"test:extended:containers": "RENDER_V3_REPETITIONS=100 npm run verify:source-root-crash && RENDER_V3_REPETITIONS=100 node --test test/owned-check-cancellation.integration.ts",
		"verify:gate": "npm run typecheck && npm run lint && npm run test:full",
		"verify:complete": "npm run verify:gate && npm run test:extended && npm run verify:unsafe-controls",
		"typecheck": "tsc --noEmit -p .",
		"lint": "biome check .",
		"verify:kernel-authority-schedules": "RENDER_V1_SCHEDULES=10000 node --test test/kernel-authority-schedules.test.ts",
		"verify:sqlite-command-atomicity": "RENDER_V2_SCHEDULES=256 node --test test/sqlite-command-atomicity.test.ts test/sqlite-command-schedules.integration.ts",
		"verify:command-crash-recovery": "node --test test/command-crash-recovery.integration.ts",
		"verify:two-client-reattach": "node --test --test-concurrency=1 test/two-client-reattach.integration.ts test/stalled-observer.performance.ts test/history-cutoff-export.test.ts test/history-cursor-transfer.test.ts",
		"verify:persistence-startup": "node --test test/persistence-startup.integration.ts test/role-recovery-startup.integration.ts",
		"verify:local-command-load": "node --test test/local-command-load.performance.ts",
		"verify:scoped-web-research": "node --test test/scoped-web-research.test.ts test/web-crash.integration.ts test/web-report-declaration.test.ts test/web-cancellation-outcome.test.ts",
		"verify:web-negative-journey": "node --test --test-name-pattern='selected negative evidence' test/scoped-web-research.test.ts",
		"verify:offhost-exposure-cutoff": "node --test --test-name-pattern=offhost-exposure-cutoff test/offhost-protection.integration.ts",
		"verify:manual-recovery-rehearsal": "node --test --test-name-pattern=manual-recovery-rehearsal test/offhost-protection.integration.ts",
		"verify:package-clean-restore": "node --test --test-name-pattern=package-clean-restore test/recovery-packages.integration.ts test/recovery-policy.test.ts",
		"verify:package-origin-auth-fence": "node --test --test-name-pattern=package-origin-auth-fence test/recovery-packages.integration.ts",
		"verify:repair-crash": "node --test --test-name-pattern=repair-crash test/recovery-packages.integration.ts",
		"verify:restore-newer-world": "node --test --test-name-pattern=restore-newer-world test/recovery-packages.integration.ts test/recovery-role-work.test.ts",
		"verify:package-validation": "node --test --test-name-pattern=package-validation test/recovery-packages.integration.ts test/recovery-package-semantics.test.ts test/recovery-role-work.test.ts test/recovery-policy.test.ts",
		"verify:durable-tool-replay": "node --test test/durable-tool-replay.integration.ts",
		"verify:workflow-task-survival": "node --test test/workflow-task-survival.test.ts",
		"verify:role-capability-refusal": "node --test test/role-capability-refusal.test.ts",
		"verify:cancellation-capacity": "node --test test/cancellation-capacity.test.ts test/role-recovery-startup.integration.ts test/role-waiting.integration.ts test/role-wait-restart.integration.ts",
		"verify:history-cutoff-export": "node --test test/history-cutoff-export.test.ts test/history-missing-data.integration.ts test/history-message.test.ts test/history-completeness.integration.ts test/history-cursor-transfer.test.ts test/role-history.test.ts",

		"verify:history-command-load": "node --test test/history-command-load.ts",
		"verify:context-continuation-independence": "node --test test/context-continuation-independence.test.ts test/workflow-task-survival.test.ts test/role-wait-restart.integration.ts test/child-replacement.test.ts",
		"verify:native-compaction-history": "node --test test/native-compaction-history.test.ts",
		"verify:policy-adoption": "node --test test/policy-adoption.test.ts test/child-replacement.test.ts",
		"verify:task-version-recovery": "node --test test/task-version-recovery.test.ts test/role-recovery-startup.integration.ts",
		"verify:independent-export-reader": "node --test test/independent-export-reader.test.ts",
		"verify:linux-profile-owned-check": "node --test test/linux-profile-owned-check.integration.ts test/owned-check-history.integration.ts test/owned-source-recovery.integration.ts",
		"verify:literal-source-roundtrip": "node --test test/literal-source-roundtrip.integration.ts test/literal-source-names.test.ts test/literal-source-names.integration.ts test/owned-source-controls.integration.ts",
		"verify:whole-container-quiescence": "node --test test/whole-container-quiescence.integration.ts test/owned-source-recovery.integration.ts test/owned-check-cancellation.integration.ts",
		"verify:source-root-crash": "node --test test/source-root-crash.integration.ts test/owned-check-crash.integration.ts",
		"verify:unsafe-controls": "node test/controls/unsafe-controls.ts"
	},
	"dependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"webfox": "4.8.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@types/node": "24.19.2",
		"typescript": "7.0.2"
	}
}

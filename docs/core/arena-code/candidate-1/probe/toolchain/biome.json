{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": { "includes": ["**", "!**/node_modules"] },
	"formatter": { "indentStyle": "tab", "lineWidth": 120 },
	"linter": {
		"rules": {
			"preset": "recommended",
			"correctness": { "noUndeclaredDependencies": "error" },
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["**/packages/**", "**/extensions/**", "**/apps/**"],
								"message": "Import another package by its name. Its internals are not part of it."
							}
						]
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["extensions/*/src/**", "packages/kit/src/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"tau-core/host": "An extension reaches the core through `tau-core` only. `answer` and the host are the host's (docs/core/primitives.md)."
								},
								"patterns": [
									{
										"group": ["**/packages/**", "**/extensions/**", "**/apps/**"],
										"message": "Import another package by its name. Its internals are not part of it."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/core/src/store/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["../host/**", "../protocol/**"],
										"message": "The store layer knows no project and no host."
									},
									{
										"group": ["**/packages/**", "**/extensions/**", "**/apps/**"],
										"message": "Import another package by its name. Its internals are not part of it."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}

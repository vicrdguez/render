{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"forceConsistentCasingInFileNames": true,
		"composite": true,
		"declaration": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"types": ["node"]
	}
}
